{
  "format": "webin-theme",
  "version": 1,

  "theme": {
    "name": "Anime Dream",
    "description": "A modern anime-inspired theme combining soft Sakura colors, magical gradients, glassmorphism, luminous accents, rounded surfaces, and subtle decorative effects.",

    "background": "#FFF7FC",
    "text": "#241B2F",

    "colors": {
      "background": "#FFF7FC",
      "surface": "#FFFFFF",
      "surfaceSecondary": "#FFF0F8",
      "surfaceTertiary": "#F4EEFF",

      "text": "#241B2F",
      "textSecondary": "#6F6278",
      "textMuted": "#9B8FA3",

      "primary": "#FF6FAE",
      "primaryHover": "#FF4F9A",
      "secondary": "#9B7BFF",
      "accent": "#62D9FF",

      "success": "#63D7A6",
      "warning": "#FFD166",
      "danger": "#FF6B81",

      "border": "#F0DDEA",
      "borderStrong": "#E2C8E0"
    },

    "backgroundStyle": {
      "type": "gradient",
      "base": "#FFF7FC",
      "opacity": 1,

      "gradient": {
        "type": "radial",
        "colors": [
          "#FFE8F3",
          "#F2E9FF",
          "#E8F8FF",
          "#FFF7FC"
        ],
        "position": "top right"
      }
    },

    "surface": {
      "background": "rgba(255,255,255,0.72)",
      "opacity": 0.78,
      "backdropFilter": "blur(18px)",
      "border": "1px solid rgba(255,255,255,0.65)",
      "shadow": "0 10px 40px rgba(126,82,139,0.10)",
      "radius": 20
    },

    "card": {
      "background": "rgba(255,255,255,0.72)",
      "border": "1px solid rgba(255,190,225,0.45)",
      "radius": 18,
      "shadow": "0 8px 30px rgba(150,100,170,0.10)",

      "hover": {
        "background": "rgba(255,255,255,0.88)",
        "border": "1px solid rgba(255,111,174,0.40)",
        "shadow": "0 12px 35px rgba(255,111,174,0.18)",
        "transform": "translateY(-2px)"
      }
    },

    "button": {
      "primary": {
        "background": "linear-gradient(135deg,#FF6FAE,#9B7BFF)",
        "text": "#FFFFFF",
        "border": "none",
        "radius": 14,
        "shadow": "0 6px 20px rgba(255,111,174,0.25)"
      },

      "secondary": {
        "background": "rgba(255,255,255,0.72)",
        "text": "#6B4D78",
        "border": "1px solid rgba(226,200,224,0.8)",
        "radius": 14
      }
    },

    "input": {
      "background": "rgba(255,255,255,0.75)",
      "text": "#241B2F",
      "placeholder": "#A99CAF",
      "border": "1px solid #EBD8E8",
      "focusBorder": "#FF6FAE",
      "focusGlow": "0 0 0 4px rgba(255,111,174,0.12)",
      "radius": 14
    },

    "navigation": {
      "background": "rgba(255,255,255,0.68)",
      "backdropFilter": "blur(22px)",
      "border": "1px solid rgba(255,255,255,0.65)",
      "shadow": "0 5px 25px rgba(100,70,120,0.08)",

      "active": {
        "background": "rgba(255,111,174,0.12)",
        "text": "#FF4F9A",
        "indicator": "#FF6FAE"
      }
    },

    "typography": {
      "fontFamily": "Inter, system-ui, sans-serif",
      "headingWeight": 700,
      "bodyWeight": 400,
      "headingColor": "#241B2F",
      "bodyColor": "#6F6278"
    },

    "effects": {
      "glow": {
        "pink": "0 0 30px rgba(255,111,174,0.20)",
        "purple": "0 0 30px rgba(155,123,255,0.20)",
        "blue": "0 0 30px rgba(98,217,255,0.18)"
      },

      "hover": {
        "transition": "all 180ms ease",
        "scale": 1.015
      },

      "focus": {
        "outline": "none",
        "ring": "0 0 0 4px rgba(155,123,255,0.14)"
      }
    },

    "decorations": {
      "style": "anime",
      "enabled": true,

      "elements": [
        {
          "type": "sparkle",
          "color": "#FFB7D7",
          "opacity": 0.55
        },
        {
          "type": "star",
          "color": "#A98BFF",
          "opacity": 0.35
        },
        {
          "type": "petal",
          "color": "#FF9EC8",
          "opacity": 0.28
        }
      ]
    },

    "scrollbar": {
      "track": "transparent",
      "thumb": "#E8C7E0",
      "thumbHover": "#FF9EC8",
      "width": 8,
      "radius": 10
    },

    "selection": {
      "background": "#FFB7D7",
      "text": "#241B2F"
    },

    "states": {
      "success": {
        "background": "rgba(99,215,166,0.12)",
        "text": "#319B72",
        "border": "rgba(99,215,166,0.28)"
      },

      "warning": {
        "background": "rgba(255,209,102,0.14)",
        "text": "#A87900",
        "border": "rgba(255,209,102,0.30)"
      },

      "danger": {
        "background": "rgba(255,107,129,0.12)",
        "text": "#D94A63",
        "border": "rgba(255,107,129,0.28)"
      }
    }
  }
}