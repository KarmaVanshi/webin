{
  "format": "webin-theme",
  "version": 1,
  "theme": {
    "id": "apple-liquid-glass",
    "name": "Apple Liquid Glass",
    "description": "Frosted translucent panels over a deep ground, in Apple's system blue.",
    "dark": true,

    "palette": {
      "background": "#0A0F1A",
      "surface": "rgba(255, 255, 255, 0.075)",
      "text": "rgba(255, 255, 255, 0.96)",
      "textMuted": "rgba(255, 255, 255, 0.6)",
      "accent": "#0A84FF",
      "onAccent": "#FFFFFF",
      "border": "rgba(255, 255, 255, 0.18)"
    },

    "radius": 20,
    "density": 1,
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif",
    "shadow": "glass",

    "effects": {
      "blur": 28,
      "surfaceAlpha": 0.075,
      "borderWidth": 0.5,
      "gradient": true,

      "backdrop": {
        "base": "#0A0F1A",
        "blobs": [
          { "color": "#0A84FF", "x": 15, "y": 10, "size": 60 },
          { "color": "#5E5CE6", "x": 85, "y": 25, "size": 55 },
          { "color": "#64D2FF", "x": 50, "y": 100, "size": 70 }
        ]
      }
    },

    "author": "Apple-inspired Liquid Glass rendering system"
  }
}
