{
  "name": "Studio Ghibli Motion",
  "version": "1.0.0",
  "description": "Soft, dreamy, and organic animations inspired by the gentle magic of Studio Ghibli films",
  "tone": "whimsical • ethereal • natural • slow-breathing",
  "duration": {
    "whisper": "120ms",
    "breeze": "280ms",
    "drift": "450ms",
    "float": "700ms",
    "cloud": "1200ms",
    "season": "2000ms",
    "eternal": "4000ms"
  },
  "easing": {
    "softIn": "cubic-bezier(0.33, 0, 0.67, 0)",
    "softOut": "cubic-bezier(0.33, 1, 0.68, 1)",
    "softInOut": "cubic-bezier(0.65, 0, 0.35, 1)",
    "wind": "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "leaf": "cubic-bezier(0.45, 0.05, 0.55, 0.95)",
    "cloud": "cubic-bezier(0.4, 0, 0.2, 1)",
    "magic": "cubic-bezier(0.34, 1.2, 0.64, 1)",
    "breath": "cubic-bezier(0.37, 0, 0.63, 1)"
  },
  "keyframes": {
    "gentleFadeIn": {
      "0%": { "opacity": "0" },
      "100%": { "opacity": "1" }
    },
    "gentleFadeOut": {
      "0%": { "opacity": "1" },
      "100%": { "opacity": "0" }
    },
    "softRise": {
      "0%": { "opacity": "0", "transform": "translateY(16px)" },
      "100%": { "opacity": "1", "transform": "translateY(0)" }
    },
    "softDescend": {
      "0%": { "opacity": "0", "transform": "translateY(-16px)" },
      "100%": { "opacity": "1", "transform": "translateY(0)" }
    },
    "float": {
      "0%, 100%": { "transform": "translateY(0)" },
      "50%": { "transform": "translateY(-8px)" }
    },
    "gentleSway": {
      "0%, 100%": { "transform": "rotate(-1.5deg)" },
      "50%": { "transform": "rotate(1.5deg)" }
    },
    "leafFall": {
      "0%": { "transform": "translateY(-20%) rotate(0deg)", "opacity": "0" },
      "10%": { "opacity": "1" },
      "90%": { "opacity": "1" },
      "100%": { "transform": "translateY(120vh) rotate(25deg)", "opacity": "0" }
    },
    "cloudDrift": {
      "0%": { "transform": "translateX(-5%)" },
      "100%": { "transform": "translateX(5%)" }
    },
    "sparkle": {
      "0%, 100%": { "opacity": "0", "transform": "scale(0.6)" },
      "50%": { "opacity": "1", "transform": "scale(1)" }
    },
    "softPulse": {
      "0%, 100%": { "opacity": "1", "transform": "scale(1)" },
      "50%": { "opacity": "0.7", "transform": "scale(0.98)" }
    },
    "magicAppear": {
      "0%": { "opacity": "0", "transform": "scale(0.92) translateY(12px)" },
      "60%": { "opacity": "1", "transform": "scale(1.02) translateY(-2px)" },
      "100%": { "opacity": "1", "transform": "scale(1) translateY(0)" }
    },
    "magicDisappear": {
      "0%": { "opacity": "1", "transform": "scale(1)" },
      "100%": { "opacity": "0", "transform": "scale(0.94) translateY(8px)" }
    },
    "windSway": {
      "0%": { "transform": "rotate(0deg) translateX(0)" },
      "25%": { "transform": "rotate(2deg) translateX(3px)" },
      "75%": { "transform": "rotate(-2deg) translateX(-3px)" },
      "100%": { "transform": "rotate(0deg) translateX(0)" }
    },
    "breath": {
      "0%, 100%": { "transform": "scale(1)" },
      "50%": { "transform": "scale(1.03)" }
    },
    "twinkle": {
      "0%, 100%": { "opacity": "0.3", "transform": "scale(0.8)" },
      "50%": { "opacity": "1", "transform": "scale(1.1)" }
    },
    "softSpin": {
      "0%": { "transform": "rotate(0deg)" },
      "100%": { "transform": "rotate(360deg)" }
    },
    "petalDance": {
      "0%": { "transform": "translateY(0) rotate(0deg) scale(1)" },
      "25%": { "transform": "translateY(-6px) rotate(4deg) scale(1.02)" },
      "50%": { "transform": "translateY(-10px) rotate(-3deg) scale(0.98)" },
      "75%": { "transform": "translateY(-4px) rotate(2deg) scale(1.01)" },
      "100%": { "transform": "translateY(0) rotate(0deg) scale(1)" }
    }
  },
  "animation": {
    "gentleFadeIn": "gentleFadeIn 450ms cubic-bezier(0.33, 1, 0.68, 1)",
    "gentleFadeOut": "gentleFadeOut 380ms cubic-bezier(0.33, 0, 0.67, 0)",
    "softRise": "softRise 600ms cubic-bezier(0.22, 0.61, 0.36, 1)",
    "softDescend": "softDescend 600ms cubic-bezier(0.22, 0.61, 0.36, 1)",
    "float": "float 4s cubic-bezier(0.37, 0, 0.63, 1) infinite",
    "gentleSway": "gentleSway 5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite",
    "leafFall": "leafFall 8s cubic-bezier(0.45, 0.05, 0.55, 0.95) forwards",
    "cloudDrift": "cloudDrift 18s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate",
    "sparkle": "sparkle 2.4s cubic-bezier(0.34, 1.2, 0.64, 1) infinite",
    "softPulse": "softPulse 3.2s cubic-bezier(0.37, 0, 0.63, 1) infinite",
    "magicAppear": "magicAppear 700ms cubic-bezier(0.34, 1.2, 0.64, 1)",
    "magicDisappear": "magicDisappear 450ms cubic-bezier(0.33, 0, 0.67, 0)",
    "windSway": "windSway 6s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite",
    "breath": "breath 4.5s cubic-bezier(0.37, 0, 0.63, 1) infinite",
    "twinkle": "twinkle 2.8s cubic-bezier(0.34, 1.2, 0.64, 1) infinite",
    "softSpin": "softSpin 12s linear infinite",
    "petalDance": "petalDance 7s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite"
  },
  "presets": {
    "entrance": {
      "soft": "softRise",
      "magic": "magicAppear",
      "whisper": "gentleFadeIn"
    },
    "exit": {
      "soft": "gentleFadeOut",
      "magic": "magicDisappear"
    },
    "ambient": {
      "float": "float",
      "sway": "gentleSway",
      "breath": "breath",
      "cloud": "cloudDrift",
      "petal": "petalDance"
    },
    "sparkle": {
      "twinkle": "twinkle",
      "sparkle": "sparkle"
    }
  }
}