{
  "format": "webin-theme",
  "version": 1,

  "theme": {
    "id": "apple-liquid-glass",
    "name": "Apple Liquid Glass",
    "description": "A transparent, Apple-inspired Liquid Glass rendering system that transforms arbitrary webpages into layered translucent glass interfaces while preserving their content and structure.",
    "dark": true,

    "mode": "global-render",

    "rendering": {
      "strategy": "dom-aware",
      "preserveContent": true,
      "preserveLayout": true,
      "preserveImages": true,
      "preserveMedia": true,
      "preserveText": true,

      "removePageBackground": true,
      "transparentRoot": true,

      "forceGlass": true,
      "forceBackdropBlur": true,
      "forceRoundedSurfaces": true,
      "forceThinBorders": true,
      "forceDepth": true,
      "forceSpecularHighlights": true
    },

    "page": {
      "background": "transparent",
      "backgroundColor": "transparent",
      "backgroundImage": "none",

      "body": {
        "background": "transparent",
        "backgroundColor": "transparent"
      },

      "root": {
        "background": "transparent",
        "backgroundColor": "transparent"
      },

      "text": {
        "color": "rgba(255,255,255,0.96)"
      },

      "font": {
        "family": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', system-ui, sans-serif",
        "weight": 450,
        "letterSpacing": "0px"
      }
    },

    "palette": {
      "background": "transparent",

      "glass": "rgba(255,255,255,0.075)",
      "glassSoft": "rgba(255,255,255,0.045)",
      "glassMedium": "rgba(255,255,255,0.09)",
      "glassStrong": "rgba(255,255,255,0.13)",
      "glassElevated": "rgba(255,255,255,0.16)",

      "text": "rgba(255,255,255,0.96)",
      "textSecondary": "rgba(255,255,255,0.72)",
      "textMuted": "rgba(255,255,255,0.60)",
      "textSubtle": "rgba(255,255,255,0.42)",

      "border": "rgba(255,255,255,0.18)",
      "borderSoft": "rgba(255,255,255,0.10)",
      "borderStrong": "rgba(255,255,255,0.25)",

      "highlight": "rgba(255,255,255,0.22)",
      "highlightStrong": "rgba(255,255,255,0.30)",

      "accent": "#0A84FF",
      "accentHover": "#409CFF",
      "accentSoft": "rgba(10,132,255,0.18)",
      "accentBorder": "rgba(10,132,255,0.55)",
      "onAccent": "#FFFFFF"
    },

    "material": {
      "default": {
        "background": "rgba(255,255,255,0.075)",
        "backdropFilter": "blur(28px) saturate(145%)",
        "webkitBackdropFilter": "blur(28px) saturate(145%)",
        "border": "0.5px solid rgba(255,255,255,0.18)",
        "boxShadow": "0 12px 40px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.14)",
        "radius": 20
      },

      "soft": {
        "background": "rgba(255,255,255,0.045)",
        "backdropFilter": "blur(24px) saturate(135%)",
        "webkitBackdropFilter": "blur(24px) saturate(135%)",
        "border": "0.5px solid rgba(255,255,255,0.10)",
        "boxShadow": "0 8px 30px rgba(0,0,0,0.12), inset 0 1px 0 rgba(255,255,255,0.08)",
        "radius": 18
      },

      "strong": {
        "background": "rgba(255,255,255,0.13)",
        "backdropFilter": "blur(38px) saturate(150%)",
        "webkitBackdropFilter": "blur(38px) saturate(150%)",
        "border": "0.5px solid rgba(255,255,255,0.22)",
        "boxShadow": "0 20px 60px rgba(0,0,0,0.24), inset 0 1px 0 rgba(255,255,255,0.18)",
        "radius": 22
      },

      "floating": {
        "background": "rgba(255,255,255,0.11)",
        "backdropFilter": "blur(36px) saturate(145%)",
        "webkitBackdropFilter": "blur(36px) saturate(145%)",
        "border": "0.5px solid rgba(255,255,255,0.20)",
        "boxShadow": "0 24px 75px rgba(0,0,0,0.30), inset 0 1px 0 rgba(255,255,255,0.16)",
        "radius": 24
      }
    },

    "effects": {
      "blur": 28,
      "saturation": 145,
      "brightness": 102,

      "borderWidth": "0.5px",

      "specular": {
        "enabled": true,
        "opacity": 0.18,
        "angle": 135,

        "gradient": "linear-gradient(135deg, rgba(255,255,255,0.22) 0%, rgba(255,255,255,0.06) 25%, rgba(255,255,255,0) 58%)"
      },

      "edgeReflection": {
        "enabled": true,
        "opacity": 0.16,
        "gradient": "linear-gradient(135deg, rgba(255,255,255,0.30), rgba(255,255,255,0.05) 45%, rgba(255,255,255,0.14))"
      },

      "innerHighlight": {
        "enabled": true,
        "value": "inset 0 1px 0 rgba(255,255,255,0.14)"
      },

      "noise": {
        "enabled": false
      },

      "glow": {
        "enabled": false
      },

      "gradients": {
        "enabled": true,
        "page": false,
        "surface": true
      }
    },

    "radius": {
      "xs": 8,
      "sm": 12,
      "md": 16,
      "lg": 20,
      "xl": 24,
      "pill": 999
    },

    "shadows": {
      "none": "none",

      "small": "0 4px 16px rgba(0,0,0,0.12)",

      "medium": "0 12px 40px rgba(0,0,0,0.18)",

      "large": "0 24px 75px rgba(0,0,0,0.28)",

      "floating": "0 30px 90px rgba(0,0,0,0.34)"
    },

    "elements": {

      "body": {
        "material": "none",
        "background": "transparent"
      },

      "navigation": {
        "material": "soft",
        "radius": 0,
        "blur": 30,
        "sticky": true
      },

      "header": {
        "material": "soft",
        "blur": 30
      },

      "footer": {
        "material": "soft",
        "blur": 28
      },

      "sidebar": {
        "material": "soft",
        "blur": 30,
        "radius": 0
      },

      "card": {
        "material": "default",
        "radius": 20
      },

      "panel": {
        "material": "default",
        "radius": 20
      },

      "modal": {
        "material": "strong",
        "radius": 24,
        "blur": 40
      },

      "popover": {
        "material": "floating",
        "radius": 22,
        "blur": 36
      },

      "dropdown": {
        "material": "floating",
        "radius": 18,
        "blur": 32
      },

      "button": {
        "material": "default",
        "radius": 14,

        "hover": {
          "background": "rgba(255,255,255,0.11)",
          "border": "rgba(255,255,255,0.25)",
          "shadow": "0 8px 24px rgba(0,0,0,0.16)"
        },

        "active": {
          "scale": 0.985
        }
      },

      "primaryButton": {
        "background": "rgba(10,132,255,0.88)",
        "hoverBackground": "rgba(64,156,255,0.92)",
        "color": "#FFFFFF",
        "border": "0.5px solid rgba(255,255,255,0.24)",
        "radius": 14,
        "shadow": "0 8px 28px rgba(10,132,255,0.22)"
      },

      "input": {
        "background": "rgba(255,255,255,0.055)",
        "focusBackground": "rgba(255,255,255,0.085)",
        "backdropFilter": "blur(20px) saturate(140%)",
        "border": "0.5px solid rgba(255,255,255,0.13)",
        "focusBorder": "rgba(10,132,255,0.65)",
        "radius": 14,
        "focusRing": "0 0 0 3px rgba(10,132,255,0.17)"
      },

      "textarea": {
        "background": "rgba(255,255,255,0.055)",
        "backdropFilter": "blur(20px) saturate(140%)",
        "border": "0.5px solid rgba(255,255,255,0.13)",
        "radius": 14
      },

      "select": {
        "background": "rgba(255,255,255,0.065)",
        "backdropFilter": "blur(20px) saturate(140%)",
        "border": "0.5px solid rgba(255,255,255,0.14)",
        "radius": 14
      },

      "table": {
        "background": "transparent",

        "header": {
          "background": "rgba(255,255,255,0.07)",
          "backdropFilter": "blur(24px)"
        },

        "row": {
          "background": "rgba(255,255,255,0.025)",
          "hoverBackground": "rgba(255,255,255,0.065)"
        },

        "border": "rgba(255,255,255,0.08)"
      },

      "image": {
        "preserveOriginal": true,
        "radius": 14
      },

      "video": {
        "preserveOriginal": true,
        "radius": 14
      },

      "code": {
        "preserveOriginal": true,
        "disableGlass": true
      },

      "canvas": {
        "preserveOriginal": true,
        "disableGlass": true
      },

      "iframe": {
        "preserveOriginal": true
      }
    },

    "domDetection": {

      "enabled": true,

      "classification": {
        "navigation": [
          "nav",
          "[role='navigation']",
          "[class*='nav']",
          "[class*='navbar']",
          "[class*='navigation']"
        ],

        "header": [
          "header",
          "[role='banner']",
          "[class*='header']"
        ],

        "sidebar": [
          "aside",
          "[class*='sidebar']",
          "[class*='side-bar']"
        ],

        "card": [
          "[class*='card']",
          "[class*='tile']",
          "[class*='item']",
          "[class*='product']"
        ],

        "modal": [
          "[role='dialog']",
          "[class*='modal']",
          "[class*='dialog']"
        ],

        "popover": [
          "[role='tooltip']",
          "[class*='popover']",
          "[class*='tooltip']"
        ],

        "button": [
          "button",
          "[role='button']",
          "[class*='btn']",
          "[class*='button']"
        ],

        "input": [
          "input",
          "textarea",
          "select"
        ]
      },

      "ignore": [
        "img",
        "video",
        "canvas",
        "svg",
        "iframe",
        "pre",
        "code",
        "[contenteditable='true']",
        "[data-liquid-glass-ignore]"
      ]
    },

    "override": {

      "background": {
        "enabled": true,
        "force": true,
        "value": "transparent"
      },

      "border": {
        "enabled": true,
        "force": true,
        "minimumWidth": "0.5px"
      },

      "radius": {
        "enabled": true,
        "force": true,
        "default": 20
      },

      "blur": {
        "enabled": true,
        "force": true
      },

      "shadow": {
        "enabled": true,
        "force": true
      }
    },

    "interaction": {
      "transition": "180ms cubic-bezier(0.2,0.8,0.2,1)",

      "hover": {
        "backgroundIncrease": 0.025,
        "borderIncrease": 0.06,
        "shadowIncrease": 0.04
      },

      "press": {
        "scale": 0.985
      },

      "focus": {
        "outline": "none",
        "ring": "0 0 0 3px rgba(10,132,255,0.18)"
      }
    },

    "scrollbar": {
      "width": 8,
      "track": "transparent",
      "thumb": "rgba(255,255,255,0.16)",
      "thumbHover": "rgba(255,255,255,0.25)",
      "radius": 999
    },

    "accessibility": {
      "respectReducedMotion": true,
      "respectReducedTransparency": true,

      "reducedTransparency": {
        "enabled": true,
        "fallbackSurface": "rgba(25,25,30,0.96)",
        "fallbackBorder": "rgba(255,255,255,0.16)",
        "disableBackdropBlur": true
      }
    },

    "performance": {
      "useGpuAcceleration": true,
      "maxBackdropLayers": 30,
      "avoidNestedBlur": true,
      "lazyApply": true,
      "observeDomChanges": true
    },

    "author": "Apple-inspired Liquid Glass rendering system"
  }
}