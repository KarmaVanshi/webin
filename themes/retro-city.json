{
  "format": "webin-theme",
  "version": 1,
  "theme": {
    "id": "retro-city-graphics",
    "name": "Retro City Graphics",
    "description": "A vibrant retro-futurist interface inspired by 1980s and 1990s city illustrations, pixel graphics, halftone printing, arcade artwork, and vintage futuristic posters.",
    "dark": true,

    "palette": {
      "background": "#0B1724",
      "surface": "#132B3A",
      "surfaceAlt": "#1D4050",

      "primary": "#39C6E8",
      "secondary": "#72D7E8",
      "accent": "#FF7F73",
      "highlight": "#FFF3C4",

      "text": "#FFF3C4",
      "textMuted": "#9ED4DD",

      "border": "#39C6E8",

      "success": "#72D7A5",
      "warning": "#FFD166",
      "danger": "#FF6B6B"
    },

    "typography": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "headingWeight": 800,
      "bodyWeight": 500,
      "letterSpacing": "0.2px"
    },

    "effects": {
      "borderRadius": "0px",
      "shadow": "4px 4px 0px #071019",
      "glow": "0 0 10px rgba(57,198,232,0.18)",
      "blur": "0px",
      "texture": "halftone"
    },

    "components": {
      "window": {
        "background": "#132B3A",
        "border": "2px solid #39C6E8",
        "titleBar": "#1D4050",
        "titleText": "#FFF3C4"
      },

      "button": {
        "background": "#39C6E8",
        "text": "#0B1724",
        "border": "2px solid #0B1724",
        "hover": "#72D7E8",
        "active": "#FF7F73"
      },

      "input": {
        "background": "#0B1724",
        "text": "#FFF3C4",
        "border": "2px solid #39C6E8"
      },

      "card": {
        "background": "#132B3A",
        "border": "2px solid #39C6E8",
        "shadow": "5px 5px 0px #071019"
      },

      "link": {
        "color": "#72D7E8",
        "hover": "#FF7F73"
      }
    },

    "graphics": {
      "style": "retro-futurist-illustration",
      "pixelated": true,
      "dithering": true,
      "halftone": true,
      "scanlines": false,
      "chromaticAberration": false,
      "vignette": false,
      "noise": "subtle",
      "resolutionFeel": "low-resolution-print"
    },

    "gradients": {
      "sunset": "linear-gradient(180deg, #39C6E8 0%, #72D7E8 48%, #FF7F73 100%)",
      "ocean": "linear-gradient(180deg, #72D7E8 0%, #39C6E8 100%)",
      "retro": "linear-gradient(90deg, #39C6E8 0%, #FFF3C4 50%, #FF7F73 100%)"
    }
  }
}